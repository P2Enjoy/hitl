{
  "name": "@hitl/sdk",
  "version": "0.1.0",
  "description": "Cryptographically signed human-in-the-loop permissions — Node.js SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "hitl-setup": "./bin/setup.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["hitl", "human-in-the-loop", "ai", "agent", "permissions", "signing"],
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.6.0",
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
