# ============================================================
# HITL Setup Credentials — ONE-TIME USE ONLY
#
# Copy to .env.setup, fill in, run `oauth/scripts/init-realm.sh`,
# then DELETE .env.setup (or at minimum remove the admin password).
#
# These credentials are NEVER needed at runtime by the agent.
# Keeping them in .env would allow an agent to self-register
# identities in the OAuth server — do not put them in .env.
# ============================================================

# Keycloak bootstrap admin — used only by the init container
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
