# ============================================================
# HITL Environment Configuration — runtime secrets
# Copy this file to .env and fill in before running.
# See .env.setup.example for one-time setup credentials.
# ============================================================

# ------------------------------------------------------------
# OAuth Server (Keycloak by default)
# New names preferred; KEYCLOAK_* accepted as fallback.
# ------------------------------------------------------------
OAUTH_SERVER_URL=http://localhost:8080
OAUTH_REALM=hitl

# Service account used by cli/tool/mcp to call the Admin REST API
# Created automatically by oauth/scripts/init-realm.sh
OAUTH_CLI_CLIENT_ID=hitl-cli
OAUTH_CLI_CLIENT_SECRET=

# ------------------------------------------------------------
# Extension / Native Messaging Host
# ------------------------------------------------------------
# Port the native messaging host HTTP relay listens on
EXTENSION_SIGNING_PORT=7331

# Timeout for waiting for a human response (seconds)
CHALLENGE_TTL_SECONDS=300

# ------------------------------------------------------------
# Nonce / Replay Protection
# ------------------------------------------------------------
NONCE_STORE_REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# MCP Server
# ------------------------------------------------------------
MCP_SERVER_PORT=8008
